#define MAX_CHARS 2048
#define MAX_INSTR 55
#define MAX_REGS 8 // Muda pra 9 se for adicionar o acumulador

// Endereços dos registradores User_HW
#define ADDR_CONTROL 0
#define ADDR_DATA    1
#define ADDR_RAM     2
#define ADDR_STEP    3
#define ADDR_READ    4

OS_STK    SSSInitialTaskStk[TASK_STACKSIZE];
OS_STK    SSSInitialTaskStk2[TASK_STACKSIZE];
char buf[MAX_CHARS + 1];
int sock, client, send = 0;

void tcp_server_send(void *p) {
    INT8U err;
    unsigned int cont_regs = 0;
    while(1){
        // buffer final de envio
        char out[MAX_CHARS];
        memset(out, 0, sizeof(out));
        const char *reg_names[] = {"R0", "R1", "R2", "R3", "R4", "R5", "R6", "PC"}; // Adiciona acumulador se quiser
        int offset = 0;

        while(cont_regs < MAX_REGS && send == 1) {
            IOWR(USERHW_0_BASE, ADDR_DATA, cont_regs); // endereça REG
            unsigned int ans = IORD(USERHW_0_BASE, ADDR_READ);

            offset += sprintf(out + offset, "%s%s=%u",
                              cont_regs > 0 ? " " : "",  // espaço antes, exceto no primeiro
                              reg_names[cont_regs],
                              ans);
            cont_regs++;
        }

        cont_regs = 0;
        // envia resposta
        int sent = send(client, out, offset, 0);

        //printf("%s\n", out);
        if (sent < 0) {
            //printf("Erro ao enviar resposta\n");

        } else {
            //printf("Enviado de volta: %d bytes\n", sent);
        }

        OSTimeDly(100);
    }
}

void load_instructions(const char *instr_str) {
	char *str_copy = strdup(instr_str); // copia a string pois strtok modifica
	printf("%s", str_copy);
	char *token;
	int addr = 0;
	int instr;

	// Itera sobre cada instrução separada por \n
	token = strtok(str_copy, "\n");
	while (token != NULL) {
		// Converte a instrução (suporta binário 0b, hex 0x, ou decimal)
		instr = (int)strtol(token, NULL, 2);

		// Carrega instrução na RAM
		IOWR(USERHW_0_BASE, ADDR_DATA, instr);    // carrega instrução no reg de dados
		IOWR(USERHW_0_BASE, ADDR_CONTROL, 1);     // end_ram vai receber writedata
		IOWR(USERHW_0_BASE, ADDR_RAM, addr);      // end_ram = addr

		printf("Instrucao %d: %d (0x%X) carregada no endereco %d\n", addr, instr, instr, addr);
		addr++;
		token = strtok(NULL, "\n");
	}
}

void tcp_server_recv(void *p) {
    struct sockaddr_in addr, cli;
    int bytes;

    alt_iniche_init();
    netmain();

    while (iniche_net_ready == 0) {
        TK_SLEEP(10);
    }

    printf("Rede pronta. IP obtido via DHCP.\n");

    sock = socket(AF_INET, SOCK_STREAM, 0);
    if (sock < 0) {
        printf("Erro criando socket\n");
        return;
    }

    memset(&addr, 0, sizeof(addr));
    addr.sin_family = AF_INET;
    addr.sin_port = htons(8080);
    addr.sin_addr.s_addr = INADDR_ANY;

    if (bind(sock, (struct sockaddr *)&addr, sizeof(addr)) < 0) {
        printf("bind() falhou\n");
        close(sock);
        return;
    }

    listen(sock, 1);
    printf("Servidor TCP pronto na porta 8080\n");
    int cli_len = sizeof(cli);
    int inst_cont = 0;
    client = accept(sock, (struct sockaddr *)&cli, &cli_len);
    if (client < 0) {
		printf("Erro no accept\n");
		close(sock);
		return;
	}
    printf("Cliente conectado.\n");
	memset(buf, 0, sizeof(buf));
    while(1){
		bytes = recv(client, buf, sizeof(buf) - 1, 0);
		send = 0;
		if (bytes <= 0) {
		    printf("Cliente desconectou antes de enviar ou recv erro (%d).\n", bytes);
		    close(client);
		    continue;
		}

		buf[bytes] = '\0';
		printf("\n%s\n", buf);
		if(buf[0] == 'S' && buf[1] == 'T' && buf[2] == 'E' && buf[3] == 'P'){
			IOWR(USERHW_0_BASE, ADDR_CONTROL, 3);
			IOWR(USERHW_0_BASE, ADDR_STEP, 1);
			printf("step");
		}
		else if(buf[0] == 'R' && buf[1] == 'U' && buf[2] == 'N'){
			IOWR(USERHW_0_BASE, ADDR_CONTROL, 4);
			IOWR(USERHW_0_BASE, ADDR_CONTROL, 2);
			printf("run");
		}
		else
			load_instructions(buf);
		send = 1;
	}
}

int main() {
    INT8U error_code;
    OSTimeSet(0);
    printf("Inicializando sistema...\n");

    error_code = OSTaskCreateExt(tcp_server_recv,
                               NULL,
                               (void *)&SSSInitialTaskStk[TASK_STACKSIZE - 1],
                               SSS_INITIAL_TASK_PRIORITY-1,
                               SSS_INITIAL_TASK_PRIORITY-1,
                               SSSInitialTaskStk,
                               TASK_STACKSIZE,
                               NULL,
                               0);
    alt_uCOSIIErrorHandler(error_code, 0);

    error_code = OSTaskCreateExt(tcp_server_send,
                               NULL,
                               (void *)&SSSInitialTaskStk2[TASK_STACKSIZE - 1],
                               SSS_INITIAL_TASK_PRIORITY,
                               SSS_INITIAL_TASK_PRIORITY,
                               SSSInitialTaskStk2,
                               TASK_STACKSIZE,
                               NULL,
                               0);
    alt_uCOSIIErrorHandler(error_code, 0);

    printf("Servidor TCP criado.\n");
    OSStart();
    while (1);
    return 0;
}
